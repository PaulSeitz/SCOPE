+def lambda_return_targets(rewards, dones, values, bootstrap, gamma, trace_lambda):
+    """Paper Eq. 2/3: values[t] is max Q(s_t); bootstrap is max Q(s_T)."""
+    next_values = jnp.concatenate((values[1:], bootstrap[None]), axis=0)
+
+    def backward(next_return, transition):
+        reward, done, next_value = transition
+        target = reward + gamma * (1 - done) * (
+            (1 - trace_lambda) * next_value + trace_lambda * next_return
+        )
+        return target, target
+
+    _, targets = jax.lax.scan(
+        backward, bootstrap, (rewards, dones, next_values), reverse=True,
+    )
+    return targets
+
