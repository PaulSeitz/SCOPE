+def stack_pixel_channels(images: jnp.ndarray) -> jnp.ndarray:
+    """``[B,T,H,W,C]`` → ``[B,H,W,T*C]`` before the first convolution.
+
+    Same axis order as the corrected monolithic pixel PQN. A reshape without
+    this transpose would mix frame and row positions.
+    """
+    if images.ndim != 5:
+        raise ValueError(
+            f"NEXUS pixel input must be [B,T,H,W,C], got shape {images.shape}"
+        )
+    batch, frames, height, width, channels = images.shape
+    moved = jnp.transpose(images, (0, 2, 3, 1, 4))
+    return moved.reshape((batch, height, width, frames * channels))
+
