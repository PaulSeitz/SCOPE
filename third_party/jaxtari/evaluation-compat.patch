+                seen.add(id(owner))
+                if "ACTION_SET" in getattr(type(owner), "__dict__", {}):
+                    owner.ACTION_SET = jnp.arange(18, dtype=jnp.int32)
+                    break
+                owner = getattr(owner, "_env", None)
 
